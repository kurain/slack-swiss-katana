{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "slack-swiss-katana",
  "main": "src/index.ts",
  "compatibility_date": "2025-12-01",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "slack_poll",
      "database_id": "bf9c39c3-0a1e-4cd1-a1ff-072ea8dc6d88",
      "migrations_dir": "migrations"
    }
  ]
  // シークレットは wrangler secret put で登録します:
  //   SLACK_SIGNING_SECRET, SLACK_BOT_TOKEN, VOTER_HASH_SECRET
}
